# Server only. Use CLIENT_SIGNALS_OPENAI_KEY in Codex environment settings.
# Standard OPENAI_API_KEY is also supported when running locally.
CLIENT_SIGNALS_OPENAI_KEY=
# Required private demo access code: 16–200 characters. Never put it in source.
COPILOT_ACCESS_CODE=
# Default loopback binding; public binding still requires session authentication.
HOST=127.0.0.1
PORT=3000
# For a reverse proxy, add exact approved HTTPS origins, comma separated. No '*'.
COPILOT_ALLOWED_ORIGINS=
